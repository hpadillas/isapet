# Plantilla procesada por la imagen oficial de Nginx (envsubst) al arrancar.
# Solo se sustituye ${BACKEND_URL}; las variables propias de Nginx se conservan.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # DNS interno de Docker: resolver "backend" en cada petición evita conservar una IP
    # antigua si el contenedor del backend se reinicia.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream ${BACKEND_URL};
    client_max_body_size 2m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # El navegador llama a la API en el mismo origen (/api/...); Nginx la reenvía al backend.
    # Al ser mismo origen, no se necesita CORS y las cookies de sesión y CSRF funcionan igual
    # que con el proxy de desarrollo de Angular.
    location ~ ^/(api|swagger-ui|v3/api-docs)(/|$) {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 60s;
    }

    location = /swagger-ui.html {
        proxy_pass $backend_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Archivos con hash en el nombre: caché larga.
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|gif|ico)$ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Rutas de Angular: cualquier ruta desconocida carga index.html (recargar /afiliados/1/plan funciona).
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
