# Copia este archivo como .env y cambia los valores marcados.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# El archivo .env está en .gitignore: nunca lo subas a Git.

# --- Acceso a la aplicación ---
# http://localhost:APP_PORT
APP_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=isapet
POSTGRES_USER=isapet
# CAMBIA ESTE VALOR. Solo se aplica la primera vez que se crea el volumen de datos;
# si cambias la clave después, ver "Solución de problemas" en el README.
POSTGRES_PASSWORD=cambia-esta-clave-de-bd
# Puerto en 127.0.0.1 del anfitrión (solo para herramientas de BD o pruebas fuera de Docker).
POSTGRES_HOST_PORT=5433

# --- Administrador inicial ---
# Se crea solo si todavía no existe ningún usuario ADMIN. Si ya existe, no se modifica.
ADMIN_USERNAME=admin
# CAMBIA ESTE VALOR. Máximo 72 bytes. Se guarda cifrada con BCrypt.
ADMIN_PASSWORD=cambia-esta-clave-de-admin
BOOTSTRAP_ADMIN_ENABLED=true

# --- Spring Boot y sesión ---
SPRING_PROFILES_ACTIVE=docker
# Zona horaria del negocio: define "hoy" y los periodos de las atenciones incluidas y los bonos.
APP_TIMEZONE=America/Bogota

SESSION_TIMEOUT=30m
# false SOLO para la demo local por HTTP. En un despliegue con HTTPS debe ser true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
# Vacío con esta configuración (Nginx sirve frontend y API en el mismo origen).
# Solo se usa si el frontend se sirve desde otro origen, p. ej. http://localhost:4200.
FRONTEND_ORIGIN=

# --- Notificaciones por correo ---
# Por defecto los correos llegan a Mailpit (bandeja de prueba): http://localhost:MAILPIT_PORT
NOTIFICACIONES_HABILITADAS=true
MAILPIT_PORT=8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=ISAPET <no-reply@isapet.local>
# Hora de la revisión diaria de periodos por terminar (cron de Spring: seg min hora día mes día-semana).
RECORDATORIO_CRON=0 0 8 * * *
# Correo real con Gmail (requiere una "contraseña de aplicación" de la cuenta):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=tu-cuenta@gmail.com
#   MAIL_PASSWORD=contraseña-de-aplicacion
#   MAIL_SMTP_AUTH=true
#   MAIL_SMTP_STARTTLS=true
#   MAIL_FROM=ISAPET <tu-cuenta@gmail.com>

# --- Pasarela de pagos ---
# Secreto con el que la pasarela firma (HMAC-SHA256) sus notificaciones al webhook. CAMBIAR en producción.
PASARELA_SECRETO=secreto-de-pruebas-isapet

# --- Tratamiento de datos personales (Ley 1581 de 2012) ---
# Responsable del tratamiento: aparece en el aviso de privacidad que se muestra al registrar afiliados.
PRIVACIDAD_RESPONSABLE=ISAPET
PRIVACIDAD_NIT=Por definir
PRIVACIDAD_DIRECCION=Por definir
PRIVACIDAD_CORREO=protecciondatos@isapet.local
PRIVACIDAD_TELEFONO=Por definir
