# Copia este archivo como .env y cambia los valores marcados.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# El archivo .env está en .gitignore: nunca lo subas a Git.

# --- Acceso a la aplicación ---
# http://localhost:APP_PORT
APP_PORT=8080

# --- PostgreSQL ---
POSTGRES_DB=isapet
POSTGRES_USER=isapet
# CAMBIA ESTE VALOR. Solo se aplica la primera vez que se crea el volumen de datos;
# si cambias la clave después, ver "Solución de problemas" en el README.
POSTGRES_PASSWORD=cambia-esta-clave-de-bd
# Puerto en 127.0.0.1 del anfitrión (solo para herramientas de BD o pruebas fuera de Docker).
POSTGRES_HOST_PORT=5433

# --- Administrador inicial ---
# Se crea solo si todavía no existe ningún usuario ADMIN. Si ya existe, no se modifica.
ADMIN_USERNAME=admin
# CAMBIA ESTE VALOR. Máximo 72 bytes. Se guarda cifrada con BCrypt.
ADMIN_PASSWORD=cambia-esta-clave-de-admin
BOOTSTRAP_ADMIN_ENABLED=true

# --- Spring Boot y sesión ---
SPRING_PROFILES_ACTIVE=docker
SESSION_TIMEOUT=30m
# false SOLO para la demo local por HTTP. En un despliegue con HTTPS debe ser true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
# Vacío con esta configuración (Nginx sirve frontend y API en el mismo origen).
# Solo se usa si el frontend se sirve desde otro origen, p. ej. http://localhost:4200.
FRONTEND_ORIGIN=
